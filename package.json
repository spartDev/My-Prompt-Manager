{
  "name": "prompt-library-extension",
  "version": "1.9.0",
  "description": "Chrome extension for managing personal prompt library",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "package": "node package-extension.cjs",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "lint": "biome check --formatter-enabled=false .",
    "lint:fix": "biome check --write --formatter-enabled=false .",
    "prepare": "if [ \"$CI\" = \"true\" ] || [ -n \"$GITHUB_ACTIONS\" ] || [ -n \"$JENKINS_URL\" ] || [ -n \"$BUILDKITE\" ]; then echo 'CI detected, skipping husky'; else husky; fi",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@crxjs/vite-plugin": "3.0.0",
    "@playwright/test": "1.64.1",
    "@tailwindcss/node": "4.3.3",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/chrome": "0.3.7",
    "@types/jsdom": "30.0.0",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/coverage-v8": "4.1.12",
    "happy-dom": "21.0.4",
    "husky": "9.1.7",
    "jsdom": "30.1.3",
    "lint-staged": "16.4.0",
    "playwright": "1.64.1",
    "postcss": "8.5.32",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "vitest": "4.1.12"
  },
  "dependencies": {
    "@floating-ui/dom": "1.8.0",
    "dompurify": "3.4.17",
    "lz-string": "1.5.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "recharts": "3.10.1",
    "uuid": "13.0.2"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": "biome check --write --formatter-enabled=false --no-errors-on-unmatched"
  }
}
